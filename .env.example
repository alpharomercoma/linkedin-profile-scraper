# Copy to .env and edit. All settings are optional.

# auto = try curl_cffi first, escalate to patchright. Also: http | browser
LPS_STRATEGY=auto

# Comma-separated proxy URLs, or a path to a newline-delimited file.
# Residential/mobile proxies are the single biggest factor in success rate;
# a bare datacenter IP is walled almost immediately.
# LPS_PROXIES=http://user:pass@host:port,http://user:pass@host2:port
# LPS_PROXIES=./proxies.txt

LPS_TIMEOUT=30
LPS_RETRIES=2
LPS_MIN_DELAY=0.4
LPS_MAX_DELAY=1.6
LPS_ACCEPT_LANGUAGE=en-US,en;q=0.9

# Browser path. Headless is far more detectable -- keep it false unless you
# are running under xvfb.
LPS_BROWSER_CHANNEL=chrome
LPS_BROWSER_HEADLESS=false
LPS_USER_DATA_DIR=.patchright-profile

LPS_CACHE_DIR=.cache
LPS_CACHE_ENABLED=true
LPS_CACHE_TTL=86400

# CAPTCHA solving is OFF unless BOTH of these are set. Costs money per solve.
# LPS_CAPTCHA_PROVIDER=capsolver     # or: 2captcha
# LPS_CAPTCHA_API_KEY=...
LPS_CAPTCHA_MAX_PER_RUN=3
LPS_CAPTCHA_TIMEOUT=180

LPS_API_MAX_CONCURRENCY=2

# When set, /api/linkedin requires X-API-Key or ?key=. Leave unset only for a
# deployment you are happy for anyone to use.
# LPS_API_KEY=

# Disable the patchright path where no Chrome exists, such as serverless.
LPS_BROWSER_ENABLED=true
